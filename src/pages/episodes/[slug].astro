---
import Shell from '../../layouts/Shell.astro';
import Player from '../../components/Player.astro';
import Platforms from '../../components/Platforms.astro';
import EpisodeArt from '../../components/EpisodeArt.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import DailySignup from '../../components/DailySignup.astro';
import { getEpisodes, formatDateLong, formatDuration, epNum, type Episode } from '../../lib/feed';

export async function getStaticPaths() {
  const episodes = await getEpisodes();
  return episodes.map((episode) => ({
    params: { slug: episode.slug },
    props: { episode },
  }));
}

interface Props {
  episode: Episode;
}
const { episode } = Astro.props;
---
<Shell
  title={`${episode.title} — Semi Doped`}
  description={episode.summary.slice(0, 200)}
  image={episode.ogImage}
  imageAlt={episode.title}
>
  <article>
    <section class="head">
      <div class="wrap headgrid">
        <EpisodeArt num={episode.num} size={128} />
        <div>
          <div class="kicker">
            <b>{epNum(episode.num)}</b>&ensp;·&ensp;{formatDateLong(episode.date)}&ensp;·&ensp;{formatDuration(episode.duration)}
          </div>
          <h1>{episode.title}</h1>
        </div>
      </div>
      <div class="wrap">
        {episode.videoId && (
          <div class="video">
            <YouTubeEmbed videoId={episode.videoId} title={episode.title} />
          </div>
        )}
        <Player src={episode.mp3} duration={episode.duration} />
        <Platforms />
      </div>
    </section>

    <section class="notes">
      <div class="wrap">
        <div class="noteshead">
          <h2 class="kicker">SHOW NOTES</h2>
          {episode.transcriptHtml ? (
            <a class="transcript" href="#transcript">
              READ THE FULL TRANSCRIPT <span class="arw">↓</span>
            </a>
          ) : (
            episode.transcriptUrl && (
              <a class="transcript" href={episode.transcriptUrl} rel="noopener">
                READ THE FULL TRANSCRIPT <span class="arw">↗</span>
              </a>
            )
          )}
        </div>
        <div class="prose" set:html={episode.notesHtml} />
        {episode.transcriptHtml ? (
          <div class="transcript-full" id="transcript">
            <div class="noteshead">
              <h2 class="kicker">TRANSCRIPT</h2>
              {episode.transcriptUrl && (
                <a class="transcript" href={episode.transcriptUrl} rel="noopener">
                  READ ON SEMI DOPED DAILY <span class="arw">↗</span>
                </a>
              )}
            </div>
            <div class="prose" set:html={episode.transcriptHtml} />
          </div>
        ) : (
          episode.transcriptUrl && (
            <div class="foot">
              <a class="transcript" href={episode.transcriptUrl} rel="noopener">
                READ THE FULL TRANSCRIPT <span class="arw">↗</span>
              </a>
            </div>
          )
        )}
        <a class="back" href="/episodes/">← ALL EPISODES</a>
      </div>
    </section>
  </article>
  <DailySignup />
</Shell>

<style>
  .head { padding: 56px 0 44px; border-bottom: 1px solid var(--hairline); }
  .headgrid {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: var(--sp-xl);
    align-items: center;
    margin-bottom: var(--sp-xl);
  }
  @media (max-width: 640px) {
    .headgrid { grid-template-columns: 1fr; }
  }
  .kicker { margin-bottom: 14px; }
  h1 { font-size: clamp(26px, 3.6vw, 40px); max-width: 24ch; }
  .video { max-width: 860px; margin-bottom: var(--sp-lg); }
  .notes { padding: 44px 0 56px; }
  .noteshead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-md);
    flex-wrap: wrap;
    max-width: 68ch;
    margin-bottom: 22px;
  }
  .transcript {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
    white-space: nowrap;
  }
  .transcript:hover { border-bottom-color: var(--accent); }
  .arw { font-family: var(--font-body); }
  /* Show notes run long; repeat the link where the reader finishes them. */
  .foot {
    max-width: 68ch;
    margin-top: var(--sp-lg);
    padding-top: var(--sp-lg);
    border-top: 1px solid var(--hairline);
  }
  /* The transcript reprint reads as its own article: hairline rule above,
     same 68ch measure as the notes. */
  .transcript-full {
    max-width: 68ch;
    margin-top: var(--sp-xl);
    padding-top: var(--sp-xl);
    border-top: 1px solid var(--hairline);
  }
  .prose { max-width: 68ch; }
  .prose :global(p) { margin-bottom: 1em; }
  .prose :global(h2) { font-size: 21px; margin: 1.6em 0 0.7em; }
  .prose :global(h3) { font-size: 17px; margin: 1.4em 0 0.6em; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--hairline); margin: var(--sp-lg) 0; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1em 1.2em; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(b), .prose :global(strong) { font-weight: 600; }
  .back {
    display: inline-block;
    margin-top: var(--sp-xl);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-decoration: none;
  }
  /* Must come after the base rules above — equal specificity, so source order
     decides. Both labels on one line is too tight below ~430px. */
  @media (max-width: 640px) {
    .noteshead { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>
