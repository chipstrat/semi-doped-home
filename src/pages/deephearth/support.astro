---
// Support page for DeepHearth. App Store Connect requires a public support
// URL alongside the privacy policy. Contact goes to a dedicated support
// mailbox, not a personal address. Standalone and noindex, like the privacy
// page beside it.
import Base from '../../layouts/Base.astro';
import WaferMark from '../../components/WaferMark.astro';

const APP = 'DeepHearth';
// Formsubmit relays the POST to the support mailbox. No account: the first
// submission triggers a one-time activation email to that inbox, and nothing
// is delivered until the link in it is clicked. After activation the address
// can be swapped for the hashed endpoint Formsubmit issues, which keeps the
// mailbox out of the page source.
const SUPPORT_EMAIL = 'glitchzoid@gmail.com';
const FORM_ACTION = `https://formsubmit.co/${SUPPORT_EMAIL}`;
const NEXT_URL = 'https://semidoped.com/deephearth/support/?sent=1';
---
<Base
  title={`${APP} Support`}
  description={`Help and support for ${APP}.`}
  noindex={true}
>
  <main class="support">
    <div class="wrap">
      <a class="home-link" href="/">
        <WaferMark size={28} />
        <span class="wm"><span class="s">SEMI </span><span class="d">DOPED</span></span>
      </a>

      <div class="kicker">SUPPORT</div>
      <h1>{APP}</h1>

      <p class="lede">{APP} is a small, self-contained app. It has no account, no sign-in, and keeps nothing on a server, so most problems are fixed on the device itself.</p>

      <h2>Common fixes</h2>
      <ul>
        <li><b>The app won't open or freezes.</b> Close it fully by swiping it away in the app switcher, then open it again. If that doesn't help, restart the device.</li>
        <li><b>Something looks wrong after an update.</b> Make sure you are on the latest version in the App Store, then force-close and reopen the app.</li>
        <li><b>Starting over.</b> Deleting and reinstalling the app returns it to a clean state. {APP} stores nothing outside the device, so there is no account or cloud data to clean up.</li>
      </ul>

      <h2>Privacy</h2>
      <p>{APP} collects no personal data and sends nothing off the device. The full policy is at <a href="/deephearth/privacy/">semidoped.com/deephearth/privacy</a>.</p>

      <h2>Get in touch</h2>
      <p>For a bug report, a question, or a feature request, use the form below. Include your device model, iOS version, and what you were doing when the problem happened. We read every message and reply as quickly as we can.</p>

      <p class="sent" id="sent" hidden>Thanks, your message is on its way. We'll reply to the address you gave.</p>

      <form class="contact" action={FORM_ACTION} method="POST">
        <input type="hidden" name="_subject" value={`${APP} support request`} />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={NEXT_URL} />
        <!-- Honeypot: hidden from people, filled by bots, dropped by the relay. -->
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

        <label>
          <span>Your email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="So we can reply" />
        </label>
        <label>
          <span>Device and iOS version</span>
          <input type="text" name="device" placeholder="e.g. iPhone 16 Pro, iOS 19.1" />
        </label>
        <label>
          <span>What happened</span>
          <textarea name="message" rows="6" required placeholder="What you were doing, what you expected, and what the app did instead."></textarea>
        </label>
        <button type="submit">Send</button>
      </form>
    </div>
  </main>
</Base>

<script>
  // The relay redirects back here with ?sent=1 after a successful submission.
  if (new URLSearchParams(location.search).get('sent') === '1') {
    const el = document.getElementById('sent');
    if (el) { el.hidden = false; el.scrollIntoView({ block: 'center' }); }
    history.replaceState(null, '', location.pathname);
  }
</script>

<style>
  .support {
    padding: 3rem 0 5rem;
  }
  .support .wrap {
    max-width: 680px;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    text-decoration: none;
    margin-bottom: 2.5rem;
  }
  .wm {
    font-family: var(--font-display, 'Oxanium', sans-serif);
    font-weight: 700;
    letter-spacing: .12em;
    font-size: .95rem;
  }
  .wm .d { color: var(--accent, #E96822); }
  .kicker {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: .75rem;
    letter-spacing: .14em;
    color: var(--accent, #E96822);
    margin-bottom: .5rem;
  }
  h1 {
    font-family: var(--font-display, 'Oxanium', sans-serif);
    font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: .01em;
    margin: 0 0 1.5rem;
  }
  .lede {
    font-size: 1.15rem;
    line-height: 1.55;
    margin-bottom: 2rem;
  }
  h2 {
    font-family: var(--font-display, 'Oxanium', sans-serif);
    font-weight: 600;
    font-size: 1.15rem;
    margin: 2rem 0 .5rem;
  }
  p, li {
    line-height: 1.65;
  }
  p {
    margin: 0 0 1rem;
  }
  ul {
    padding-left: 1.2rem;
    margin: 0 0 1rem;
  }
  li {
    margin-bottom: .75rem;
  }
  a {
    color: var(--accent, #E96822);
  }
  .contact {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .contact label {
    display: grid;
    gap: .35rem;
  }
  .contact label span {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: .75rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .75;
  }
  .contact input,
  .contact textarea {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 6px;
    padding: .65rem .8rem;
    width: 100%;
    box-sizing: border-box;
  }
  .contact input:focus,
  .contact textarea:focus {
    outline: none;
    border-color: var(--accent, #E96822);
  }
  .contact textarea {
    resize: vertical;
  }
  .contact button {
    justify-self: start;
    font-family: var(--font-display, 'Oxanium', sans-serif);
    font-weight: 700;
    letter-spacing: .06em;
    font-size: .95rem;
    color: #fff;
    background: var(--accent, #E96822);
    border: none;
    border-radius: 999px;
    padding: .7rem 1.6rem;
    cursor: pointer;
    transition: filter .2s ease;
  }
  .contact button:hover {
    filter: brightness(1.08);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .sent {
    border: 1px solid var(--accent, #E96822);
    border-radius: 6px;
    padding: .8rem 1rem;
    margin: 1rem 0 0;
  }
</style>
